#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import json
import random
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd
import torch

from src.models.kh_supersonic_global_kappa_q_logamp import (
    KHSupersonicGlobalPINN,
)

from scripts.pinn_supersonic.train_local_supersonic_kappa_q_logamp import (
    compute_losses,
    spectral_loss,
)


def resolve_path(value: str | Path) -> Path:
    path = Path(value).expanduser()

    if not path.is_absolute():
        path = Path.cwd() / path

    return path.resolve()


def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def as_bool(series: pd.Series) -> pd.Series:
    if pd.api.types.is_bool_dtype(series):
        return series.fillna(False)

    text = (
        series.astype(str)
        .str.strip()
        .str.lower()
    )

    return text.isin(
        {"true", "1", "yes", "y"}
    )


def build_model(
    config: dict[str, Any],
) -> KHSupersonicGlobalPINN:
    m = config["model"]

    return KHSupersonicGlobalPINN(
        alpha_min=float(config["alpha_min"]),
        alpha_max=float(config["alpha_max"]),
        mach_min=float(config["mach_min"]),
        mach_max=float(config["mach_max"]),
        xi_max=float(m["xi_max"]),
        mapping_scale=float(
            m["mapping_scale"]
        ),
        spectral_width=int(
            m["spectral_width"]
        ),
        spectral_depth=int(
            m["spectral_depth"]
        ),
        modal_width=int(
            m["modal_width"]
        ),
        modal_depth=int(
            m["modal_depth"]
        ),
        n_frequencies=int(
            m["n_frequencies"]
        ),
        mode_experts=int(
            m["mode_experts"]
        ),
        cr_min=float(m["cr_min"]),
        cr_max=float(m["cr_max"]),
        ci_floor=float(m["ci_floor"]),
        ci_max=float(m["ci_max"]),
    )


def load_dataset(
    config: dict[str, Any],
) -> pd.DataFrame:
    path = resolve_path(
        config["dataset_file"]
    )

    frame = pd.read_csv(path)

    required = {
        "Mach",
        "alpha",
        "cr",
        "ci",
        "mach_split",
        "usable_as_training_anchor",
    }

    missing = required - set(frame.columns)

    if missing:
        raise RuntimeError(
            f"Dataset missing columns: "
            f"{sorted(missing)}"
        )

    frame["Mach"] = pd.to_numeric(
        frame["Mach"],
        errors="raise",
    )

    frame["alpha"] = pd.to_numeric(
        frame["alpha"],
        errors="raise",
    )

    frame["cr"] = pd.to_numeric(
        frame["cr"],
        errors="raise",
    )

    frame["ci"] = pd.to_numeric(
        frame["ci"],
        errors="raise",
    )

    frame["usable_as_training_anchor"] = (
        as_bool(
            frame[
                "usable_as_training_anchor"
            ]
        )
    )

    return (
        frame.sort_values(
            ["Mach", "alpha"]
        )
        .reset_index(drop=True)
    )


def build_training_metadata(
    frame: pd.DataFrame,
) -> tuple[
    list[float],
    dict[float, tuple[float, float]],
]:
    train = frame[
        frame["mach_split"].eq("train")
    ].copy()

    train_machs = sorted(
        float(x)
        for x in train["Mach"].unique()
    )

    bounds: dict[
        float,
        tuple[float, float],
    ] = {}

    for mach in train_machs:
        local = train[
            np.isclose(
                train["Mach"].to_numpy(float),
                mach,
                atol=1e-12,
                rtol=0.0,
            )
        ]

        bounds[mach] = (
            float(local["alpha"].min()),
            float(local["alpha"].max()),
        )

    return train_machs, bounds


def load_spectral_targets(
    frame: pd.DataFrame,
    train_machs: list[float],
    model: KHSupersonicGlobalPINN,
    device: torch.device,
) -> dict[
    float,
    dict[str, torch.Tensor],
]:
    dtype = next(
        model.parameters()
    ).dtype

    anchors = frame[
        frame[
            "usable_as_training_anchor"
        ]
    ].copy()

    # Critical leakage guard.
    bad = anchors[
        ~anchors["mach_split"].eq("train")
    ]

    if not bad.empty:
        raise RuntimeError(
            "Training anchors found outside "
            "mach_split=train."
        )

    targets = {}

    for mach in train_machs:
        local = anchors[
            np.isclose(
                anchors["Mach"].to_numpy(float),
                mach,
                atol=1e-12,
                rtol=0.0,
            )
        ].copy()

        if "anchor_rank" in local.columns:
            local = local.sort_values(
                "anchor_rank"
            )
        else:
            local = local.sort_values(
                "alpha"
            )

        if local.empty:
            raise RuntimeError(
                f"M={mach:.2f}: no spectral training "
                "anchor found."
            )

        alpha = torch.tensor(
            local["alpha"].to_numpy(float),
            device=device,
            dtype=dtype,
        ).view(-1, 1)

        cr = torch.tensor(
            local["cr"].to_numpy(float),
            device=device,
            dtype=dtype,
        ).view(-1, 1)

        ci = torch.tensor(
            local["ci"].to_numpy(float),
            device=device,
            dtype=dtype,
        ).view(-1, 1)

        cr_scale = max(
            float(
                local["cr"].max()
                - local["cr"].min()
            ),
            0.05,
        )

        ci_scale = max(
            float(
                local["ci"].max()
                - local["ci"].min()
            ),
            0.02,
        )

        targets[mach] = {
            "alpha": alpha,
            "cr": cr,
            "ci": ci,
            "cr_scale": torch.tensor(
                cr_scale,
                device=device,
                dtype=dtype,
            ),
            "ci_scale": torch.tensor(
                ci_scale,
                device=device,
                dtype=dtype,
            ),
        }

    n_anchors = sum(
        len(value["alpha"])
        for value in targets.values()
    )

    if n_anchors != 52:
        raise RuntimeError(
            f"Expected 52 training anchors, "
            f"found {n_anchors}."
        )

    return targets


def local_loss_config(
    config: dict[str, Any],
    *,
    mach: float,
    alpha_min: float,
    alpha_max: float,
) -> dict[str, Any]:
    # compute_losses() only needs these
    # fixed-Mach quantities plus model/loss config.
    return {
        "Mach": float(mach),
        "alpha_min": float(alpha_min),
        "alpha_max": float(alpha_max),
        "model": config["model"],
        "loss_weights": config[
            "loss_weights"
        ],
    }


def save_checkpoint(
    path: Path,
    *,
    model: KHSupersonicGlobalPINN,
    config: dict[str, Any],
    stage: str,
    step: int,
    loss: float,
) -> None:
    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    torch.save(
        {
            "model_state_dict":
                model.state_dict(),
            "config": config,
            "stage": stage,
            "step": int(step),
            "loss": float(loss),
        },
        path,
    )


@torch.no_grad()
def spectral_audit(
    model: KHSupersonicGlobalPINN,
    frame: pd.DataFrame,
    *,
    device: torch.device,
    include_test: bool,
) -> tuple[
    pd.DataFrame,
    dict[str, Any],
]:
    if include_test:
        audit = frame.copy()
    else:
        audit = frame[
            ~frame["mach_split"].eq("test")
        ].copy()

    dtype = next(
        model.parameters()
    ).dtype

    alpha = torch.tensor(
        audit["alpha"].to_numpy(float),
        dtype=dtype,
        device=device,
    ).view(-1, 1)

    mach = torch.tensor(
        audit["Mach"].to_numpy(float),
        dtype=dtype,
        device=device,
    ).view(-1, 1)

    cr_pred, ci_pred = (
        model.get_spectrum(
            alpha,
            mach,
        )
    )

    result = audit.copy()

    result["cr_pred"] = (
        cr_pred.detach()
        .cpu()
        .numpy()
        .reshape(-1)
    )

    result["ci_pred"] = (
        ci_pred.detach()
        .cpu()
        .numpy()
        .reshape(-1)
    )

    result["cr_abs_error"] = np.abs(
        result["cr_pred"]
        - result["cr"]
    )

    result["ci_abs_error"] = np.abs(
        result["ci_pred"]
        - result["ci"]
    )

    result["spectral_error"] = np.sqrt(
        (
            result["cr_pred"]
            - result["cr"]
        ) ** 2
        + (
            result["ci_pred"]
            - result["ci"]
        ) ** 2
    )

    result["omega_i_ref"] = (
        result["alpha"]
        * result["ci"]
    )

    result["omega_i_pred"] = (
        result["alpha"]
        * result["ci_pred"]
    )

    result["omega_i_abs_error"] = (
        np.abs(
            result["omega_i_pred"]
            - result["omega_i_ref"]
        )
    )

    def stats(
        data: pd.DataFrame,
    ) -> dict[str, Any]:
        return {
            "n": int(len(data)),
            "n_mach": int(
                data["Mach"].nunique()
            ),
            "cr_mae": float(
                data[
                    "cr_abs_error"
                ].mean()
            ),
            "cr_max_abs": float(
                data[
                    "cr_abs_error"
                ].max()
            ),
            "ci_mae": float(
                data[
                    "ci_abs_error"
                ].mean()
            ),
            "ci_max_abs": float(
                data[
                    "ci_abs_error"
                ].max()
            ),
            "omega_i_mae": float(
                data[
                    "omega_i_abs_error"
                ].mean()
            ),
            "spectral_error_mean":
                float(
                    data[
                        "spectral_error"
                    ].mean()
                ),
            "spectral_error_max":
                float(
                    data[
                        "spectral_error"
                    ].max()
                ),
        }

    metrics: dict[str, Any] = {
        "global_visible": stats(result),
        "by_split": {},
        "by_mach": {},
    }

    for split, group in result.groupby(
        "mach_split",
        sort=True,
    ):
        metrics["by_split"][
            str(split)
        ] = stats(group)

    for mach, group in result.groupby(
        "Mach",
        sort=True,
    ):
        metrics["by_mach"][
            f"{float(mach):.2f}"
        ] = {
            "split": str(
                group[
                    "mach_split"
                ].iloc[0]
            ),
            **stats(group),
        }

    return result, metrics


def main() -> None:
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--config",
        required=True,
    )

    parser.add_argument(
        "--output-dir",
        default=None,
    )

    parser.add_argument(
        "--device",
        default="cuda",
    )

    parser.add_argument(
        "--prefit-steps",
        type=int,
        default=2000,
    )

    parser.add_argument(
        "--modal-steps",
        type=int,
        default=4000,
    )

    parser.add_argument(
        "--joint-steps",
        type=int,
        default=4000,
    )

    parser.add_argument(
        "--spectral-lr",
        type=float,
        default=2e-4,
    )

    parser.add_argument(
        "--modal-lr",
        type=float,
        default=1e-4,
    )

    parser.add_argument(
        "--joint-spectral-lr",
        type=float,
        default=5e-5,
    )

    parser.add_argument(
        "--joint-modal-lr",
        type=float,
        default=5e-5,
    )

    parser.add_argument(
        "--n-interior",
        type=int,
        default=1024,
    )

    parser.add_argument(
        "--n-boundary",
        type=int,
        default=96,
    )

    parser.add_argument(
        "--print-every",
        type=int,
        default=100,
    )

    parser.add_argument(
        "--audit-test",
        action="store_true",
        help=(
            "Expose the held-out test Mach "
            "values. Do not use during model "
            "development."
        ),
    )

    parser.add_argument(
        "--overwrite",
        action="store_true",
    )

    args = parser.parse_args()

    config_path = resolve_path(
        args.config
    )

    config = json.loads(
        config_path.read_text(
            encoding="utf-8"
        )
    )

    output_dir = resolve_path(
        args.output_dir
        if args.output_dir is not None
        else config["output_dir"]
    )

    if output_dir.exists():
        if not args.overwrite:
            raise RuntimeError(
                f"{output_dir} exists. "
                "Use --overwrite."
            )
    else:
        output_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    seed = int(
        config.get(
            "seed",
            12345,
        )
    )

    set_seed(seed)

    device = torch.device(
        args.device
    )

    if (
        device.type == "cuda"
        and not torch.cuda.is_available()
    ):
        raise RuntimeError(
            "CUDA requested but unavailable."
        )

    frame = load_dataset(config)

    train_machs, alpha_bounds = (
        build_training_metadata(
            frame
        )
    )

    if len(train_machs) < 2:
        raise RuntimeError(
            "Training requires at least 2 distinct "
            f"Mach values, got {len(train_machs)}."
        )

    validation_machs = sorted(
        float(x)
        for x in frame.loc[
            frame[
                "mach_split"
            ].eq("validation"),
            "Mach",
        ].unique()
    )

    test_machs = sorted(
        float(x)
        for x in frame.loc[
            frame[
                "mach_split"
            ].eq("test"),
            "Mach",
        ].unique()
    )

    print(
        "train Mach:",
        " ".join(
            f"{m:.2f}"
            for m in train_machs
        ),
    )

    print(
        "validation Mach:",
        " ".join(
            f"{m:.2f}"
            for m in validation_machs
        ),
    )

    print(
        "test Mach (sealed):",
        " ".join(
            f"{m:.2f}"
            for m in test_machs
        ),
    )

    model = (
        build_model(config)
        .to(device)
    )

    spectral_targets = (
        load_spectral_targets(
            frame,
            train_machs,
            model,
            device,
        )
    )

    try:
        torch_generator = (
            torch.Generator(
                device=device
            )
        )
    except TypeError:
        torch_generator = (
            torch.Generator(
                device=device.type
            )
        )

    torch_generator.manual_seed(
        seed + 17
    )

    mach_rng = np.random.default_rng(
        seed + 29
    )

    initial_path = (
        output_dir
        / "initial_checkpoint.pt"
    )

    save_checkpoint(
        initial_path,
        model=model,
        config=config,
        stage="initial",
        step=0,
        loss=float("nan"),
    )

    history: list[
        dict[str, Any]
    ] = []

    best_paths: dict[
        str,
        Path,
    ] = {}

    best_losses: dict[
        str,
        float,
    ] = {}

    def choose_mach() -> float:
        index = int(
            mach_rng.integers(
                0,
                len(train_machs),
            )
        )

        return float(
            train_machs[index]
        )

    def prepare_mach(
        mach: float,
    ) -> dict[str, Any]:
        model.set_mach_context(
            mach
        )

        a_min, a_max = (
            alpha_bounds[mach]
        )

        return local_loss_config(
            config,
            mach=mach,
            alpha_min=a_min,
            alpha_max=a_max,
        )

    def update_best(
        stage: str,
        step: int,
        loss_value: float,
    ) -> None:
        previous = best_losses.get(
            stage,
            float("inf"),
        )

        if loss_value >= previous:
            return

        best_losses[stage] = (
            loss_value
        )

        path = (
            output_dir
            / f"best_{stage}_checkpoint.pt"
        )

        save_checkpoint(
            path,
            model=model,
            config=config,
            stage=stage,
            step=step,
            loss=loss_value,
        )

        best_paths[stage] = path

    # --------------------------------------------------
    # Stage 1 — spectral prefit
    # --------------------------------------------------

    for p in model.modal_parameters():
        p.requires_grad_(False)

    for p in model.spectral_parameters():
        p.requires_grad_(True)

    if args.prefit_steps > 0:
        optimizer = torch.optim.Adam(
            model.spectral_parameters(),
            lr=args.spectral_lr,
        )

        for step in range(
            1,
            args.prefit_steps + 1,
        ):
            mach = choose_mach()

            prepare_mach(mach)

            optimizer.zero_grad(
                set_to_none=True
            )

            loss = spectral_loss(
                model,
                spectral_targets[mach],
            )

            if not torch.isfinite(loss):
                raise RuntimeError(
                    "Non-finite spectral "
                    f"loss at step {step}."
                )

            loss.backward()
            optimizer.step()

            value = float(
                loss.detach()
            )

            update_best(
                "spectral_prefit",
                step,
                value,
            )

            history.append(
                {
                    "stage":
                        "spectral_prefit",
                    "step": step,
                    "Mach": mach,
                    "loss": value,
                    "spectral": value,
                }
            )

            if (
                step == 1
                or step
                % args.print_every == 0
                or step
                == args.prefit_steps
            ):
                print(
                    "[spectral_prefit] "
                    f"{step}/"
                    f"{args.prefit_steps} "
                    f"M={mach:.2f} "
                    f"loss={value:.6e}",
                    flush=True,
                )

    # --------------------------------------------------
    # Stage 2 — modal physics, frozen spectrum
    # --------------------------------------------------

    for p in model.spectral_parameters():
        p.requires_grad_(False)

    for p in model.modal_parameters():
        p.requires_grad_(True)

    if args.modal_steps > 0:
        optimizer = torch.optim.Adam(
            model.modal_parameters(),
            lr=args.modal_lr,
        )

        for step in range(
            1,
            args.modal_steps + 1,
        ):
            mach = choose_mach()

            local_cfg = (
                prepare_mach(mach)
            )

            optimizer.zero_grad(
                set_to_none=True
            )

            loss, values = (
                compute_losses(
                    model,
                    local_cfg,
                    spectral_targets=None,
                    modal_targets=None,
                    generator=
                        torch_generator,
                    n_interior=
                        args.n_interior,
                    n_boundary=
                        args.n_boundary,
                    include_spectral=False,
                    include_modal=False,
                    device=device,
                )
            )

            if not torch.isfinite(loss):
                raise RuntimeError(
                    "Non-finite modal "
                    f"loss at step {step}."
                )

            loss.backward()
            optimizer.step()

            update_best(
                "modal_frozen_spectrum",
                step,
                values["loss"],
            )

            history.append(
                {
                    "stage":
                        "modal_frozen_spectrum",
                    "step": step,
                    "Mach": mach,
                    **values,
                }
            )

            if (
                step == 1
                or step
                % args.print_every == 0
                or step
                == args.modal_steps
            ):
                print(
                    "[modal_frozen] "
                    f"{step}/"
                    f"{args.modal_steps} "
                    f"M={mach:.2f} "
                    f"loss="
                    f"{values['loss']:.6e} "
                    f"rk="
                    f"{values['riccati_kappa']:.3e} "
                    f"rq="
                    f"{values['riccati_q']:.3e}",
                    flush=True,
                )

    # --------------------------------------------------
    # Stage 3 — joint
    # --------------------------------------------------

    for p in model.spectral_parameters():
        p.requires_grad_(True)

    for p in model.modal_parameters():
        p.requires_grad_(True)

    if args.joint_steps > 0:
        optimizer = torch.optim.Adam(
            [
                {
                    "params":
                        list(
                            model
                            .spectral_parameters()
                        ),
                    "lr":
                        args.joint_spectral_lr,
                },
                {
                    "params":
                        list(
                            model
                            .modal_parameters()
                        ),
                    "lr":
                        args.joint_modal_lr,
                },
            ]
        )

        for step in range(
            1,
            args.joint_steps + 1,
        ):
            mach = choose_mach()

            local_cfg = (
                prepare_mach(mach)
            )

            optimizer.zero_grad(
                set_to_none=True
            )

            loss, values = (
                compute_losses(
                    model,
                    local_cfg,
                    spectral_targets=
                        spectral_targets[
                            mach
                        ],
                    modal_targets=None,
                    generator=
                        torch_generator,
                    n_interior=
                        args.n_interior,
                    n_boundary=
                        args.n_boundary,
                    include_spectral=True,
                    include_modal=False,
                    device=device,
                )
            )

            if not torch.isfinite(loss):
                raise RuntimeError(
                    "Non-finite joint "
                    f"loss at step {step}."
                )

            loss.backward()
            optimizer.step()

            update_best(
                "joint",
                step,
                values["loss"],
            )

            history.append(
                {
                    "stage": "joint",
                    "step": step,
                    "Mach": mach,
                    **values,
                }
            )

            if (
                step == 1
                or step
                % args.print_every == 0
                or step
                == args.joint_steps
            ):
                print(
                    "[joint] "
                    f"{step}/"
                    f"{args.joint_steps} "
                    f"M={mach:.2f} "
                    f"loss="
                    f"{values['loss']:.6e} "
                    f"spec="
                    f"{values['spectral']:.3e}",
                    flush=True,
                )

    # --------------------------------------------------
    # Select checkpoint
    # --------------------------------------------------

    selected = None

    for stage in [
        "joint",
        "modal_frozen_spectrum",
        "spectral_prefit",
    ]:
        if stage in best_paths:
            selected = best_paths[
                stage
            ]
            break

    if selected is None:
        selected = initial_path

    checkpoint = torch.load(
        selected,
        map_location=device,
    )

    model.load_state_dict(
        checkpoint[
            "model_state_dict"
        ]
    )

    torch.save(
        {
            "model_state_dict":
                model.state_dict(),
            "config": config,
            "selected_checkpoint":
                str(selected),
            "best_stage_losses":
                best_losses,
        },
        output_dir
        / "final_checkpoint.pt",
    )

    # --------------------------------------------------
    # Audit — test remains sealed unless explicit flag
    # --------------------------------------------------

    predictions, metrics = (
        spectral_audit(
            model,
            frame,
            device=device,
            include_test=
                bool(args.audit_test),
        )
    )

    predictions.to_csv(
        output_dir
        / "spectral_audit_predictions.csv",
        index=False,
    )

    (
        output_dir
        / "spectral_metrics.json"
    ).write_text(
        json.dumps(
            metrics,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    pd.DataFrame(
        history
    ).to_csv(
        output_dir
        / "training_history.csv",
        index=False,
    )

    (
        output_dir
        / "resolved_config.json"
    ).write_text(
        json.dumps(
            config,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    (
        output_dir
        / "checkpoint_selection.json"
    ).write_text(
        json.dumps(
            {
                "selected_checkpoint":
                    str(selected),
                "best_stage_losses":
                    best_losses,
                "test_audited":
                    bool(
                        args.audit_test
                    ),
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    print()
    print("=" * 80)
    print("GLOBAL S4M0 TRAINING COMPLETE")
    print("=" * 80)

    print(
        "selected:",
        selected,
    )

    print()
    print(
        json.dumps(
            metrics[
                "by_split"
            ],
            indent=2,
        )
    )

    if not args.audit_test:
        print()
        print(
            "TEST SPLIT REMAINS SEALED."
        )

    print()
    print(
        "output:",
        output_dir,
    )


if __name__ == "__main__":
    main()
